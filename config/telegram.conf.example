# Copy this file to ~/.config/access-watch/telegram.conf and fill in your values.
# Then lock it down:   chmod 600 ~/.config/access-watch/telegram.conf
#
# Get BOT_TOKEN from @BotFather on Telegram (/newbot).
# Get CHAT_ID by messaging your bot once, then opening:
#   https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
# and reading result[].message.chat.id

BOT_TOKEN="123456789:AA-replace-with-your-bot-token"
CHAT_ID="123456789"

# Optional: comma-separated usernames to treat as "foreign" (alert on any activity).
# Leave empty to disable. Example: WATCH_USERS="it,quniv"
WATCH_USERS="it"

# The user this machine belongs to. Their own LOCAL activity (sudo, console /
# GUI sessions) is not alerted on; anything from a remote host still is, even
# as this user. install.sh fills this in; empty means "the user running the
# watcher".
OWNER_USER=""

# Optional: comma-separated extra users treated like OWNER_USER (e.g. "gdm").
ALLOW_USERS=""

# Optional: label shown in alerts. Defaults to hostname if empty.
HOST_LABEL=""
